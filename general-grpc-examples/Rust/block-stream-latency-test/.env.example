# Required — Yellowstone gRPC endpoint (the block stream)
GRPC_ENDPOINT=https://your-yellowstone-endpoint:443

# Optional auth token for the gRPC endpoint
GRPC_X_TOKEN=your-token-here

# Optional — Solana JSON-RPC endpoint (HTTP) for getBlock latency checks.
# A DIFFERENT transport from GRPC_ENDPOINT. Omit to disable latency measurement.
# RPC_URL=https://api.mainnet-beta.solana.com

# Slots to wait after a block arrives before calling getBlock (default: 32, ~14s at 450ms/slot)
LATENCY_LAG_SLOTS=32

# Measure latency every Nth block (1 = every block; raise to ease RPC rate limits)
LATENCY_SAMPLE_EVERY=1

# Slack incoming webhook URL — omit to log-only (no Slack alerts)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
