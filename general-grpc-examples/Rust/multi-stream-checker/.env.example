# ── Required ─────────────────────────────────────────────────────────────────
# Yellowstone gRPC endpoint (no trailing slash)
GRPC_ENDPOINT=https://your-yellowstone-node.com

# Accounts watched by transaction stream 1 (comma-separated, at least one)
ACCOUNT_INCLUDE_1=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Accounts watched by transaction stream 2 (comma-separated, at least one)
ACCOUNT_INCLUDE_2=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8,srmqPvymJeFKQ4zGQed1GFppgkRHL9kaELCbyksJtPX

# ── Optional ──────────────────────────────────────────────────────────────────
# Bearer token required by some Yellowstone nodes (omit if not needed)
GRPC_X_TOKEN=your_token_here

# Commitment level: processed | confirmed | finalized
# COMMITMENT sets the default for all three streams. Each stream may override it
# — set COMMITMENT_1=processed and COMMITMENT_2=confirmed with the same account
# list to time one set of accounts at two commitment levels side by side.
# An unrecognised value fails at startup rather than falling back silently.
COMMITMENT=confirmed
# COMMITMENT_1=processed
# COMMITMENT_2=confirmed
# COMMITMENT_BLOCKS_META=confirmed

# How many slots of transactions to hold while waiting for the matching
# blocks_meta update. Slots that fall this far behind the chain head are
# dropped and logged as "never timed".
LATENCY_BUFFER_SLOTS=300

# Slack incoming-webhook URL. When set, every stream disconnect/reconnect is
# posted to Slack in addition to being logged locally. Leave unset to log only.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Set to false to stop printing a line per transaction entirely — useful when
# you only want the periodic [STATS] summary below, not the per-tx firehose.
# Percentile sampling is unaffected either way.
LOG_TRANSACTIONS=true

# Set to false to drop the transaction signature from each latency log line.
# Ignored when LOG_TRANSACTIONS=false.
LOG_SIGNATURES=true

# How often (seconds) to print p50/p95/p99 latency for each stream, covering
# the samples recorded since the previous report. Set to 0 to disable.
STATS_INTERVAL_SECS=10

# Tracing verbosity: error | warn | info | debug | trace
# RUST_LOG=debug also logs every raw stream update as it arrives.
RUST_LOG=info
