# Yellowstone/Rabbitstream gRPC endpoint (must include port)
ENDPOINT=https://your-endpoint.solana-mainnet.example.com:10000

# Auth token for the endpoint
X_TOKEN=your_x_token_here

# Comma-separated program/account addresses to filter on. Every received
# transaction is also verified to actually reference one of these addresses
# (checked against the transaction's message.account_keys); mismatches are
# logged as warnings and counted in the run summary.
ACCOUNT_INCLUDE=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P,pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA

# true to print each transaction signature, false to suppress
LOG_SIG=true

# How often to print throughput stats (seconds)
STATS_INTERVAL_SECS=5

# Auto-stop after this many minutes; omit or set 0 to run forever. On exit,
# a summary is printed with total transactions received, how many included
# an ACCOUNT_INCLUDE address, and throughput stats.
RUN_DURATION_MINS=60

# Deployment region tag, prefixed on error/metrics logs
REGION=us-east-1

# Slack incoming webhook URL for disconnection alerts (leave empty to only
# log to console)
SLACK_URL=
