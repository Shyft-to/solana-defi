# --- Transaction stream (e.g. Rabbitstream) ---

# gRPC endpoint that streams transactions (e.g https://rabbitstream.ams.shyft.to)
ENDPOINT=https://your-endpoint.solana-mainnet.example.com

# Auth token for ENDPOINT
X_TOKEN=your_x_token_here

# Optional display name for ENDPOINT in logs and the summary. Leave unset to
# show the endpoint URL (scheme stripped) instead.
ENDPOINT_NAME=rabbitstream

# --- Account-update stream ---
# Rabbitstream itself typically only streams transactions, so this is
# usually a separate Yellowstone gRPC provider that supports account
# subscriptions.

# gRPC endpoint that streams account updates (port not compulsory) 
ACCOUNTS_ENDPOINT=https://grpc.ams.shyft.to

# Auth token for ACCOUNTS_ENDPOINT
ACCOUNTS_X_TOKEN=your_accounts_x_token_here

# Optional display name for ACCOUNTS_ENDPOINT in logs and the summary. Leave
# unset to show the endpoint URL (scheme stripped) instead.
ACCOUNTS_ENDPOINT_NAME=yellowstone

# --- Shared ---

# program/account address watched on both streams. Every
# received transaction is also verified to actually reference one of these
# addresses (checked against the transaction's message.account_keys);
# mismatches are logged live as warnings (not broken out in the run summary).
# account updates subscribe to this as owner field
ACCOUNT_INCLUDE=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# true to print each transaction signature, false to suppress
LOG_SIG=true

# How often to print throughput stats for both streams (seconds)
STATS_INTERVAL_SECS=5

# How long (seconds) to wait for a signature to show up on the other stream
# before counting it as that stream's exclusive miss
MATCH_TIMEOUT_SECS=10

# Grace period (seconds) after startup during which a one-sided signature is
# treated as connection-startup skew, not a genuine miss. The two streams
# connect independently and neither backfills, so whichever one finishes
# subscribing first can briefly see chain activity the other — not yet
# listening — can never be shown. Real matches inside this window still
# count normally; only the miss classification is suppressed. Set to 0 to
# disable.
WARMUP_SECS=5

# true to print every signature seen on the account stream but never on the
# tx stream (with the wall-clock time each was first seen) at the end of the
# report; false to suppress that dump and keep just the count
PRINT_MISSED_SIGS=true

# Auto-stop after this many minutes; omit or set 0 to run forever. On exit,
# a summary is printed covering both streams: throughput, and the
# account-vs-transaction arrival race breakdown (who arrived first, and how
# often, plus p50/p95/p99 lead-time and stream-exclusive counts).
RUN_DURATION_MINS=60

# Deployment region tag, prefixed on error/metrics logs
REGION=us-east-1

# Slack incoming webhook URL for disconnection alerts (leave empty to only
# log to console)
SLACK_URL=
